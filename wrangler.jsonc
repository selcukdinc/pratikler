{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "girisimcilik-pratik",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "girisimcilik-pratik",
			// `wrangler d1 create girisimcilik-pratik` çıktısındaki id ile değiştirin
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],

	"routes": [{ "pattern": "girisimcilik.selcukdinc.dev", "custom_domain": true }],
	"observability": {
		"enabled": false
	}
}
