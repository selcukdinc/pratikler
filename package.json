{
  "name": "pratikler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "denetle": "tsc -b && vitest run && vite build",
    "db:migrate:local": "wrangler d1 migrations apply pratikler --local",
    "db:migrate:remote": "wrangler d1 migrations apply pratikler --remote",
    "deploy": "npm run build && wrangler deploy",
    "sorular:sql": "node --experimental-strip-types scripts/sorular-sql.ts"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "katex": "^0.16.47",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
